    "settings.refresh.schedule_explanation": {
      "extractionState": "manual",
      "comment": "Explains the fixed automatic refresh behavior; keep the five-minute cadence explicit.",
      "localizations": {
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "接收變更通知，並每 5 分鐘自動同步；也可手動重新整理。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "接收变更通知，并每 5 分钟自动同步；也可手动刷新。" } },
        "en": { "stringUnit": { "state": "translated", "value": "Receives change notifications and syncs automatically every 5 minutes; you can also refresh manually." } },
        "ja": { "stringUnit": { "state": "translated", "value": "変更通知を受信し、5分ごとに自動同期します。手動で更新することもできます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "변경 알림을 받고 5분마다 자동으로 동기화하며, 수동으로 새로 고칠 수도 있습니다." } },
        "es": { "stringUnit": { "state": "translated", "value": "Recibe notificaciones de cambios y se sincroniza automáticamente cada 5 minutos; también puedes actualizar manualmente." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Reçoit les notifications de modification et se synchronise automatiquement toutes les 5 minutes ; vous pouvez aussi actualiser manuellement." } },
        "de": { "stringUnit": { "state": "translated", "value": "Empfängt Änderungsmitteilungen und synchronisiert automatisch alle 5 Minuten; eine manuelle Aktualisierung ist ebenfalls möglich." } }
      }
    },
    "settings.freshness.never_succeeded": {
