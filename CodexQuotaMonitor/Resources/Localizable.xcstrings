    "activity.source.disclosure": {
      "extractionState": "manual",
      "comment": "Translator note: UTC activity only. The current month is a local sum of returned daily totals. Account activity does not return input/output tokens. Never describe this as billing, invoicing, accounting, or complete account usage.",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 UTC 活動資料。當月總數由此 Mac 將已回傳的每日總數加總；帳戶活動回應未提供輸入與輸出 Token。這不是帳單或計費資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 UTC 活动数据。当月总数由此 Mac 将已返回的每日总数相加；账户活动响应未提供输入与输出 Token。这不是账单或计费数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is UTC activity data. This Mac totals the current month from returned daily totals; account activity responses do not provide input or output tokens. This is not billing data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは UTC のアクティビティデータです。この Mac が返された日別合計を今月分として集計します。アカウントアクティビティ応答は入力・出力トークンを提供しません。請求データではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UTC 활동 데이터입니다. 이 Mac이 반환된 일별 합계를 이번 달 값으로 합산합니다. 계정 활동 응답은 입력 및 출력 토큰을 제공하지 않습니다. 청구 데이터가 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son datos de actividad UTC. Este Mac suma el mes actual a partir de los totales diarios devueltos; las respuestas de actividad de la cuenta no proporcionan tokens de entrada ni de salida. No son datos de facturación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit de données d’activité UTC. Ce Mac additionne le mois en cours à partir des totaux quotidiens renvoyés ; les réponses d’activité du compte ne fournissent pas les jetons d’entrée ou de sortie. Ce ne sont pas des données de facturation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind UTC-Aktivitätsdaten. Dieser Mac summiert den aktuellen Monat aus den zurückgegebenen Tagessummen; Kontoaktivitätsantworten liefern keine Eingabe- oder Ausgabe-Tokens. Dies sind keine Abrechnungsdaten."
          }
        }
      }
    },
