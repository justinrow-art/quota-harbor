    "onboarding.providers.title": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "額度來源" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "额度来源" } }, "en": { "stringUnit": { "state": "translated", "value": "Quota sources" } }, "ja": { "stringUnit": { "state": "translated", "value": "利用枠ソース" } }, "ko": { "stringUnit": { "state": "translated", "value": "할당량 소스" } }, "es": { "stringUnit": { "state": "translated", "value": "Fuentes de cuota" } }, "fr": { "stringUnit": { "state": "translated", "value": "Sources de quota" } }, "de": { "stringUnit": { "state": "translated", "value": "Kontingentquellen" } }
    } },
    "onboarding.providers.explanation": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "Codex 固定啟用；你可以另外勾選 Claude Code。勾選只會啟用本機顯示，不會修改 Claude Code 設定；額度連接需稍後另行確認。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Codex 固定启用；你可以另外勾选 Claude Code。勾选只会启用本机显示，不会修改 Claude Code 设置；额度连接需稍后另行确认。" } }, "en": { "stringUnit": { "state": "translated", "value": "Codex stays enabled, and you can optionally select Claude Code. Selecting it only enables local display and does not change Claude Code settings; quota connection requires separate confirmation later." } }, "ja": { "stringUnit": { "state": "translated", "value": "Codex は常に有効です。Claude Code は任意で選択できます。選択してもローカル表示が有効になるだけで Claude Code の設定は変更されません。利用枠の接続は後で別途確認が必要です。" } }, "ko": { "stringUnit": { "state": "translated", "value": "Codex는 항상 활성화되며 Claude Code를 선택적으로 추가할 수 있습니다. 선택은 로컬 표시만 활성화하고 Claude Code 설정을 변경하지 않습니다. 할당량 연결은 나중에 별도 확인이 필요합니다." } }, "es": { "stringUnit": { "state": "translated", "value": "Codex permanece activo y puedes seleccionar Claude Code de forma opcional. La selección solo activa la visualización local y no cambia los ajustes de Claude Code; la conexión de cuota requiere una confirmación aparte." } }, "fr": { "stringUnit": { "state": "translated", "value": "Codex reste activé et Claude Code peut être sélectionné en option. La sélection active seulement l’affichage local sans modifier les réglages de Claude Code ; la connexion du quota demande une confirmation séparée." } }, "de": { "stringUnit": { "state": "translated", "value": "Codex bleibt aktiviert; Claude Code kann optional ausgewählt werden. Die Auswahl aktiviert nur die lokale Anzeige und ändert keine Claude-Code-Einstellungen. Die Kontingentverbindung muss später separat bestätigt werden." } }
    } },
    "onboarding.connections.title": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "檢視連線與額度" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "查看连接与额度" } }, "en": { "stringUnit": { "state": "translated", "value": "Review connections and quota" } }, "ja": { "stringUnit": { "state": "translated", "value": "接続と利用枠を確認" } }, "ko": { "stringUnit": { "state": "translated", "value": "연결 및 할당량 검토" } }, "es": { "stringUnit": { "state": "translated", "value": "Revisar conexiones y cuotas" } }, "fr": { "stringUnit": { "state": "translated", "value": "Vérifier les connexions et les quotas" } }, "de": { "stringUnit": { "state": "translated", "value": "Verbindungen und Kontingente prüfen" } }
    } },
    "onboarding.connections.explanation": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "App 會分別顯示已啟用平台的連線狀態與實際取得的額度；尚未取得的值不會顯示成 0。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "App 会分别显示已启用平台的连接状态与实际取得的额度；尚未取得的值不会显示为 0。" } }, "en": { "stringUnit": { "state": "translated", "value": "The app reports connection and retrieved quota separately for enabled providers. Missing values are never shown as zero." } }, "ja": { "stringUnit": { "state": "translated", "value": "有効なプロバイダごとに接続状態と取得済みの利用枠を別々に表示し、未取得の値を 0 として表示しません。" } }, "ko": { "stringUnit": { "state": "translated", "value": "앱은 활성화된 제공업체별 연결 상태와 실제로 가져온 할당량을 별도로 표시하며, 가져오지 못한 값을 0으로 표시하지 않습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "La app muestra por separado la conexión y la cuota obtenida de cada proveedor activo; los valores ausentes nunca aparecen como cero." } }, "fr": { "stringUnit": { "state": "translated", "value": "L’app affiche séparément la connexion et le quota obtenu pour chaque fournisseur activé ; une valeur absente n’est jamais affichée comme zéro." } }, "de": { "stringUnit": { "state": "translated", "value": "Die App zeigt Verbindung und abgerufenes Kontingent für jeden aktivierten Anbieter getrennt an; fehlende Werte erscheinen nie als null." } }
    } },
    "onboarding.preview.title": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "預覽並完成" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "预览并完成" } }, "en": { "stringUnit": { "state": "translated", "value": "Preview and finish" } }, "ja": { "stringUnit": { "state": "translated", "value": "プレビューして完了" } }, "ko": { "stringUnit": { "state": "translated", "value": "미리보기 및 완료" } }, "es": { "stringUnit": { "state": "translated", "value": "Vista previa y finalización" } }, "fr": { "stringUnit": { "state": "translated", "value": "Aperçu et finalisation" } }, "de": { "stringUnit": { "state": "translated", "value": "Vorschau und Abschluss" } }
    } },
    "onboarding.preview.explanation": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "以下是已啟用平台的選單列預覽。尚未取得額度時會顯示狀態，不會捏造 0%。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "以下是已启用平台的菜单栏预览。尚未取得额度时会显示状态，不会虚构 0%。" } }, "en": { "stringUnit": { "state": "translated", "value": "This is the menu bar preview for enabled providers. Missing quota data shows a state instead of an invented 0%." } }, "ja": { "stringUnit": { "state": "translated", "value": "有効なプロバイダのメニューバープレビューです。利用枠データがない場合は、架空の 0% ではなく状態を表示します。" } }, "ko": { "stringUnit": { "state": "translated", "value": "활성화된 제공업체의 메뉴 막대 미리보기입니다. 할당량 데이터가 없으면 임의의 0% 대신 상태를 표시합니다." } }, "es": { "stringUnit": { "state": "translated", "value": "Esta es la vista previa en la barra de menús de los proveedores activos. Sin datos de cuota se muestra un estado, no un 0 % inventado." } }, "fr": { "stringUnit": { "state": "translated", "value": "Voici l’aperçu dans la barre des menus des fournisseurs activés. Sans données de quota, un état s’affiche au lieu d’un 0 % inventé." } }, "de": { "stringUnit": { "state": "translated", "value": "Dies ist die Menüleistenvorschau für aktivierte Anbieter. Ohne Kontingentdaten wird ein Status statt erfundener 0 % angezeigt." } }
    } },
    "onboarding.step.completed": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "已完成" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "已完成" } }, "en": { "stringUnit": { "state": "translated", "value": "Completed" } }, "ja": { "stringUnit": { "state": "translated", "value": "完了" } }, "ko": { "stringUnit": { "state": "translated", "value": "완료됨" } }, "es": { "stringUnit": { "state": "translated", "value": "Completado" } }, "fr": { "stringUnit": { "state": "translated", "value": "Terminé" } }, "de": { "stringUnit": { "state": "translated", "value": "Abgeschlossen" } }
    } },
    "onboarding.step.current": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前步驟" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前步骤" } }, "en": { "stringUnit": { "state": "translated", "value": "Current step" } }, "ja": { "stringUnit": { "state": "translated", "value": "現在の手順" } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 단계" } }, "es": { "stringUnit": { "state": "translated", "value": "Paso actual" } }, "fr": { "stringUnit": { "state": "translated", "value": "Étape actuelle" } }, "de": { "stringUnit": { "state": "translated", "value": "Aktueller Schritt" } }
    } },
    "onboarding.step.upcoming": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "尚未開始" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "尚未开始" } }, "en": { "stringUnit": { "state": "translated", "value": "Upcoming" } }, "ja": { "stringUnit": { "state": "translated", "value": "未開始" } }, "ko": { "stringUnit": { "state": "translated", "value": "예정됨" } }, "es": { "stringUnit": { "state": "translated", "value": "Próximo" } }, "fr": { "stringUnit": { "state": "translated", "value": "À venir" } }, "de": { "stringUnit": { "state": "translated", "value": "Bevorstehend" } }
    } },
    "onboarding.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎使用 QuotaHarbor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 QuotaHarbor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to QuotaHarbor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaHarbor へようこそ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaHarbor에 오신 것을 환영합니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida a QuotaHarbor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans QuotaHarbor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei QuotaHarbor"
          }
        }
      }
    },
    "onboarding.menu_bar_residency": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前請先安裝並登入 ChatGPT；程式啟動後會常駐在 macOS 選單列，方便你隨時查看額度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前请先安装并登录 ChatGPT；程序启动后会常驻在 macOS 菜单栏，方便你随时查看额度。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install and sign in to ChatGPT first. After launch, this app stays in the macOS menu bar so quota is always within reach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に ChatGPT をインストールしてサインインしてください。起動後は macOS のメニューバーに常駐し、いつでも使用量を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 ChatGPT를 설치하고 로그인하세요. 실행 후 앱은 macOS 메뉴 막대에 상주하여 언제든 할당량을 확인할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero instala ChatGPT e inicia sesión. Después, esta app permanecerá en la barra de menús de macOS para que la cuota esté siempre accesible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez d’abord ChatGPT et connectez-vous. Ensuite, cette app restera dans la barre des menus de macOS afin que le quota soit toujours accessible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere zuerst ChatGPT und melde dich an. Danach bleibt diese App in der macOS-Menüleiste, damit das Kontingent jederzeit erreichbar ist."
          }
        }
      }
    },
    "onboarding.reopen": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若關閉浮動卡片，可點選選單列圖示，或從「應用程式」重新開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若关闭浮动卡片，可点按菜单栏图标，或从“应用程序”重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you close the floating card, click the menu bar icon or reopen the app from Applications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フローティングカードを閉じた場合は、メニューバーのアイコンをクリックするか、「アプリケーション」から開き直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플로팅 카드를 닫은 경우 메뉴 막대 아이콘을 클릭하거나 응용 프로그램에서 앱을 다시 여세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cierras la tarjeta flotante, haz clic en el icono de la barra de menús o vuelve a abrir la app desde Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous fermez la carte flottante, cliquez sur l’icône de la barre des menus ou rouvrez l’app depuis Applications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die schwebende Karte geschlossen wird, auf das Menüleistensymbol klicken oder die App aus „Programme“ erneut öffnen."
          }
        }
      }
    },
    "onboarding.quit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉卡片不會結束程式；請在選單列圖示上按右鍵或 Control-click，再選擇「結束」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭卡片不会退出程序；请右键单击或按住 Control 点按菜单栏图标，再选择“退出”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the card does not quit the app; right-click or Control-click the menu bar icon, then choose Quit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードを閉じてもアプリは終了しません。メニューバーアイコンを右クリックするか、Control キーを押しながらクリックして、「終了」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드를 닫아도 앱은 종료되지 않습니다. 메뉴 막대 아이콘을 마우스 오른쪽 버튼으로 클릭하거나 Control-클릭한 다음 종료를 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la tarjeta no cierra la app; haz clic con el botón derecho o Control-clic en el icono de la barra de menús y elige Salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer la carte ne quitte pas l’app ; cliquez avec le bouton droit ou faites un Control-clic sur l’icône de la barre des menus, puis choisissez Quitter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schließen der Karte beendet die App nicht; klicke mit der rechten Maustaste oder bei gedrückter Control-Taste auf das Menüleistensymbol und wähle „Beenden“."
          }
        }
      }
    },
    "onboarding.login_item.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時自動啟動"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 열기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir al iniciar sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir à la connexion"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Anmeldung öffnen"
          }
        }
      }
    },
    "onboarding.login_item.explanation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時自動啟動可隨時在設定中關閉。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时自动启动可随时在设置中关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn this off at any time in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定はいつでも設定画面でオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든 이 기능을 끌 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes desactivarlo en cualquier momento en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désactiver cette option à tout moment dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann jederzeit in den Einstellungen deaktiviert werden."
          }
        }
      }
    },
    "onboarding.login_item.enabled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用登入時自動啟動。你可以隨時在「設定」中關閉。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用登录时自动启动。你可以随时在“设置”中关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login is enabled. You can turn it off in Settings at any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に開く設定を有効にしました。設定画面でいつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 열기가 활성화되었습니다. 설정에서 언제든 끌 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha activado Abrir al iniciar sesión. Puedes desactivarlo en Ajustes en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ouverture à la connexion est activée. Vous pouvez la désactiver à tout moment dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bei Anmeldung öffnen“ ist aktiviert. Dies kann jederzeit in den Einstellungen deaktiviert werden."
          }
        }
      }
    },
    "onboarding.login_item.requires_approval": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已登錄；請到「系統設定」核准登入項目。之後仍可在「設定」中關閉。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已注册；请在“系统设置”中批准登录项。之后仍可在“设置”中关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registered. Approve the login item in System Settings; you can still turn it off later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録されました。システム設定でログイン項目を許可してください。後で設定画面からオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록되었습니다. 시스템 설정에서 로그인 항목을 승인하세요. 나중에 설정에서 끌 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado. Aprueba el ítem de inicio en Ajustes del Sistema; después podrás desactivarlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Autorisez l’élément d’ouverture dans Réglages Système ; vous pourrez ensuite le désactiver dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registriert. Das Anmeldeobjekt in den Systemeinstellungen erlauben; es kann später in den Einstellungen deaktiviert werden."
          }
        }
      }
    },
    "onboarding.login_item.saved_disabled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定已儲存。需要時可在「設定」中啟用登入時自動啟動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已保存。需要时可在“设置”中启用登录时自动启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings saved. Turn on Open at Login later in Settings if needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存しました。必要な場合は後で設定画面から有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 저장되었습니다. 필요한 경우 나중에 설정에서 로그인 시 열기를 켜세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes guardados. Activa Abrir al iniciar sesión más adelante si lo necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages enregistrés. Activez l’ouverture à la connexion plus tard si nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen gesichert. „Bei Anmeldung öffnen“ kann bei Bedarf später aktiviert werden."
          }
        }
      }
    },
    "onboarding.login_item.declined": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
