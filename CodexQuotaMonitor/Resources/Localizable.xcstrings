    } },
    "settings.providers.account": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "帳號（已遮罩）" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "账号（已遮罩）" } }, "en": { "stringUnit": { "state": "translated", "value": "Account (masked)" } }, "ja": { "stringUnit": { "state": "translated", "value": "アカウント（マスク済み）" } }, "ko": { "stringUnit": { "state": "translated", "value": "계정(마스킹됨)" } }, "es": { "stringUnit": { "state": "translated", "value": "Cuenta (oculta)" } }, "fr": { "stringUnit": { "state": "translated", "value": "Compte (masqué)" } }, "de": { "stringUnit": { "state": "translated", "value": "Konto (maskiert)" } }
    } },
    "settings.providers.last_updated": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "最後更新" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "最后更新" } }, "en": { "stringUnit": { "state": "translated", "value": "Last updated" } }, "ja": { "stringUnit": { "state": "translated", "value": "最終更新" } }, "ko": { "stringUnit": { "state": "translated", "value": "마지막 업데이트" } }, "es": { "stringUnit": { "state": "translated", "value": "Última actualización" } }, "fr": { "stringUnit": { "state": "translated", "value": "Dernière mise à jour" } }, "de": { "stringUnit": { "state": "translated", "value": "Zuletzt aktualisiert" } }
    } },
    "settings.providers.primary_metric": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "選單列主要額度" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "菜单栏主要额度" } }, "en": { "stringUnit": { "state": "translated", "value": "Primary menu bar quota" } }, "ja": { "stringUnit": { "state": "translated", "value": "メニューバーの主な利用枠" } }, "ko": { "stringUnit": { "state": "translated", "value": "메뉴 막대 기본 할당량" } }, "es": { "stringUnit": { "state": "translated", "value": "Cuota principal de la barra" } }, "fr": { "stringUnit": { "state": "translated", "value": "Quota principal de la barre" } }, "de": { "stringUnit": { "state": "translated", "value": "Primäres Menüleisten-Kontingent" } }
    } },
    "settings.providers.empty_recovery": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前未選擇平台；選單列會保持中性 AI 狀態。勾選任一平台即可恢復顯示。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "目前未选择平台；菜单栏会保持中性 AI 状态。勾选任一平台即可恢复显示。" } }, "en": { "stringUnit": { "state": "translated", "value": "No platform is selected. The menu bar stays in a neutral AI state until you select one." } }, "ja": { "stringUnit": { "state": "translated", "value": "プラットフォームが未選択です。選択するまでメニューバーは中立の AI 状態を保ちます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "선택한 플랫폼이 없습니다. 하나를 선택할 때까지 메뉴 막대는 중립 AI 상태를 유지합니다." } }, "es": { "stringUnit": { "state": "translated", "value": "No hay plataformas seleccionadas. La barra mantiene un estado de IA neutro hasta que elijas una." } }, "fr": { "stringUnit": { "state": "translated", "value": "Aucune plateforme n’est sélectionnée. La barre reste dans un état IA neutre jusqu’à une sélection." } }, "de": { "stringUnit": { "state": "translated", "value": "Keine Plattform ist ausgewählt. Die Menüleiste bleibt neutral, bis Sie eine auswählen." } }
    } },
    "settings.claude_relay.title": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "Claude Code 額度連接" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Claude Code 额度连接" } }, "en": { "stringUnit": { "state": "translated", "value": "Claude Code quota connection" } }, "ja": { "stringUnit": { "state": "translated", "value": "Claude Code 利用枠の接続" } }, "ko": { "stringUnit": { "state": "translated", "value": "Claude Code 할당량 연결" } }, "es": { "stringUnit": { "state": "translated", "value": "Conexión de cuota de Claude Code" } }, "fr": { "stringUnit": { "state": "translated", "value": "Connexion du quota Claude Code" } }, "de": { "stringUnit": { "state": "translated", "value": "Claude-Code-Kontingentverbindung" } }
    } },
    "settings.claude_relay.explanation": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "勾選 Claude Code 不會修改其設定。連接額度需另外確認；確認後會先備份，再寫入本 App 的 statusLine 指令。移除時只會在安全指紋吻合時還原，衝突則停止並保留復原資料。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "勾选 Claude Code 不会修改其设置。连接额度需另外确认；确认后会先备份，再写入本 App 的 statusLine 指令。移除时只会在安全指纹匹配时恢复，冲突则停止并保留恢复数据。" } }, "en": { "stringUnit": { "state": "translated", "value": "Selecting Claude Code does not change its settings. Connecting quota requires separate confirmation; the app backs up settings before writing its statusLine command. Removal restores only when the safety fingerprint matches, and conflicts stop without deleting recovery data." } }, "ja": { "stringUnit": { "state": "translated", "value": "Claude Code を選択しても設定は変更されません。利用枠の接続には別途確認が必要で、確認後に設定をバックアップしてから本アプリの statusLine コマンドを書き込みます。削除時は安全なフィンガープリントが一致する場合だけ復元し、競合時は復元データを残して停止します。" } }, "ko": { "stringUnit": { "state": "translated", "value": "Claude Code를 선택해도 설정은 변경되지 않습니다. 할당량 연결은 별도 확인이 필요하며, 확인 후 설정을 백업한 다음 이 앱의 statusLine 명령을 기록합니다. 제거 시 안전 지문이 일치할 때만 복원하고 충돌하면 복구 데이터를 보존한 채 중지합니다." } }, "es": { "stringUnit": { "state": "translated", "value": "Seleccionar Claude Code no cambia sus ajustes. Conectar la cuota requiere otra confirmación; la app crea una copia antes de escribir su comando statusLine. Al quitarlo solo restaura si coincide la huella de seguridad y, si hay conflicto, se detiene sin borrar los datos de recuperación." } }, "fr": { "stringUnit": { "state": "translated", "value": "Sélectionner Claude Code ne modifie pas ses réglages. La connexion du quota demande une confirmation séparée ; l’app sauvegarde les réglages avant d’écrire sa commande statusLine. La suppression ne restaure que si l’empreinte de sécurité correspond ; en cas de conflit, elle s’arrête sans effacer les données de récupération." } }, "de": { "stringUnit": { "state": "translated", "value": "Die Auswahl von Claude Code ändert keine Einstellungen. Die Kontingentverbindung muss separat bestätigt werden; vor dem Schreiben des statusLine-Befehls wird eine Sicherung erstellt. Beim Entfernen wird nur bei passendem Sicherheitsfingerabdruck wiederhergestellt; bei Konflikten stoppt die App und behält Wiederherstellungsdaten." } }
    } },
    "settings.claude_relay.install": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "連接 Claude Code 額度" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接 Claude Code 额度" } }, "en": { "stringUnit": { "state": "translated", "value": "Connect Claude Code quota" } }, "ja": { "stringUnit": { "state": "translated", "value": "Claude Code の利用枠を接続" } }, "ko": { "stringUnit": { "state": "translated", "value": "Claude Code 할당량 연결" } }, "es": { "stringUnit": { "state": "translated", "value": "Conectar la cuota de Claude Code" } }, "fr": { "stringUnit": { "state": "translated", "value": "Connecter le quota Claude Code" } }, "de": { "stringUnit": { "state": "translated", "value": "Claude-Code-Kontingent verbinden" } }
    } },
    "settings.claude_relay.remove": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "移除額度連接並還原設定" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "移除额度连接并还原设置" } }, "en": { "stringUnit": { "state": "translated", "value": "Remove connection and restore settings" } }, "ja": { "stringUnit": { "state": "translated", "value": "接続を削除して設定を復元" } }, "ko": { "stringUnit": { "state": "translated", "value": "연결 제거 및 설정 복원" } }, "es": { "stringUnit": { "state": "translated", "value": "Quitar la conexión y restaurar los ajustes" } }, "fr": { "stringUnit": { "state": "translated", "value": "Supprimer la connexion et restaurer les réglages" } }, "de": { "stringUnit": { "state": "translated", "value": "Verbindung entfernen und Einstellungen wiederherstellen" } }
    } },
    "settings.claude_relay.confirm_install": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "額度欄位只適用 Claude.ai Pro／Max，且要等該工作階段完成第一次 API 回應；五小時／七天窗口可能各自缺席，其他帳號可能永遠不會顯示額度。確認後會先備份，再寫入 Claude Code 的 statusLine 設定。是否繼續？" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "额度字段只适用于 Claude.ai Pro／Max，且要等该会话完成第一次 API 响应；五小时／七天窗口可能各自缺失，其他账号可能永远不会显示额度。确认后会先备份，再写入 Claude Code 的 statusLine 设置。是否继续？" } }, "en": { "stringUnit": { "state": "translated", "value": "Quota fields are available only to Claude.ai Pro/Max after that session’s first API response. Either the five-hour or seven-day window may be absent, and other accounts may never show quota. Confirming will back up, then write Claude Code’s statusLine setting. Continue?" } }, "ja": { "stringUnit": { "state": "translated", "value": "使用量フィールドは Claude.ai Pro／Max のみ対象で、そのセッションの最初の API 応答後に表示されます。5時間／7日間のどちらかがない場合があり、対象外のアカウントでは表示されないことがあります。確認するとバックアップ後に Claude Code の statusLine 設定を書き込みます。続けますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "할당량 필드는 Claude.ai Pro/Max에서만 해당 세션의 첫 API 응답 후 제공됩니다. 5시간/7일 창 중 하나가 없을 수 있으며 대상이 아닌 계정에는 할당량이 표시되지 않을 수 있습니다. 확인하면 백업 후 Claude Code statusLine 설정을 기록합니다. 계속할까요?" } }, "es": { "stringUnit": { "state": "translated", "value": "Los campos de cuota solo están disponibles para Claude.ai Pro/Max después de la primera respuesta de API de esa sesión. Puede faltar la ventana de 5 horas o de 7 días, y otras cuentas pueden no mostrar cuota nunca. Al confirmar se hará una copia y se escribirá statusLine de Claude Code. ¿Continuar?" } }, "fr": { "stringUnit": { "state": "translated", "value": "Les champs de quota sont réservés à Claude.ai Pro/Max après la première réponse API de la session. La fenêtre de 5 heures ou de 7 jours peut manquer, et les autres comptes peuvent ne jamais afficher de quota. La confirmation sauvegardera puis écrira le réglage statusLine de Claude Code. Continuer ?" } }, "de": { "stringUnit": { "state": "translated", "value": "Kontingentfelder sind nur für Claude.ai Pro/Max nach der ersten API-Antwort der Sitzung verfügbar. Das 5-Stunden- oder 7-Tage-Fenster kann fehlen; bei anderen Konten wird möglicherweise nie ein Kontingent angezeigt. Nach der Bestätigung wird Claude Codes statusLine gesichert und geschrieben. Fortfahren?" } }
    } },
    "settings.claude_relay.confirm_remove": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "確認後會移除本 App 的連接，並還原安裝前的 Claude Code 設定。是否繼續？" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "确认后会移除本 App 的连接，并还原安装前的 Claude Code 设置。是否继续？" } }, "en": { "stringUnit": { "state": "translated", "value": "Confirming will remove this app’s connection and restore the prior Claude Code settings. Continue?" } }, "ja": { "stringUnit": { "state": "translated", "value": "確認するとこのアプリの接続を削除し、以前の Claude Code 設定を復元します。続けますか？" } }, "ko": { "stringUnit": { "state": "translated", "value": "확인하면 이 앱의 연결을 제거하고 이전 Claude Code 설정을 복원합니다. 계속할까요?" } }, "es": { "stringUnit": { "state": "translated", "value": "Al confirmar se quitará la conexión y se restaurarán los ajustes anteriores de Claude Code. ¿Continuar?" } }, "fr": { "stringUnit": { "state": "translated", "value": "La confirmation supprimera la connexion et restaurera les réglages Claude Code précédents. Continuer ?" } }, "de": { "stringUnit": { "state": "translated", "value": "Nach der Bestätigung wird die Verbindung entfernt und die frühere Claude-Code-Einstellung wiederhergestellt. Fortfahren?" } }
    } },
    "settings.claude_relay.state.not_installed": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "尚未連接" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "尚未连接" } }, "en": { "stringUnit": { "state": "translated", "value": "Not connected" } }, "ja": { "stringUnit": { "state": "translated", "value": "未接続" } }, "ko": { "stringUnit": { "state": "translated", "value": "연결되지 않음" } }, "es": { "stringUnit": { "state": "translated", "value": "Sin conexión" } }, "fr": { "stringUnit": { "state": "translated", "value": "Non connecté" } }, "de": { "stringUnit": { "state": "translated", "value": "Nicht verbunden" } }
    } },
    "settings.claude_relay.state.installed": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "已連接（可還原）" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "已连接（可还原）" } }, "en": { "stringUnit": { "state": "translated", "value": "Connected (restorable)" } }, "ja": { "stringUnit": { "state": "translated", "value": "接続済み（復元可能）" } }, "ko": { "stringUnit": { "state": "translated", "value": "연결됨(복원 가능)" } }, "es": { "stringUnit": { "state": "translated", "value": "Conectado (restaurable)" } }, "fr": { "stringUnit": { "state": "translated", "value": "Connecté (restaurable)" } }, "de": { "stringUnit": { "state": "translated", "value": "Verbunden (wiederherstellbar)" } }
    } },
    "settings.claude_relay.state.conflict": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "偵測到既有或衝突設定；未進行修改" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "检测到现有或冲突设置；未进行修改" } }, "en": { "stringUnit": { "state": "translated", "value": "Existing or conflicting settings detected; nothing changed" } }, "ja": { "stringUnit": { "state": "translated", "value": "既存または競合する設定を検出しました。変更していません" } }, "ko": { "stringUnit": { "state": "translated", "value": "기존 또는 충돌 설정이 감지되어 변경하지 않음" } }, "es": { "stringUnit": { "state": "translated", "value": "Se detectaron ajustes existentes o en conflicto; no se cambió nada" } }, "fr": { "stringUnit": { "state": "translated", "value": "Réglages existants ou conflictuels détectés ; aucune modification" } }, "de": { "stringUnit": { "state": "translated", "value": "Vorhandene oder widersprüchliche Einstellungen erkannt; nichts geändert" } }
    } },
    "settings.claude_relay.state.manual_recovery": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "需要手動復原。請保留復原檔案與備份，且不要公開備份內容。App 不會自動覆寫 Claude 設定；請依支援文件的手動復原流程處理。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "需要手动恢复。请保留 recovery files 和备份，且不要公开备份内容。App 不会自动覆盖 Claude settings；请按照支持文档中的手动恢复流程处理。" } }, "en": { "stringUnit": { "state": "translated", "value": "Manual recovery is required. Keep the recovery files and backup, and do not share the backup contents. The app will not overwrite Claude settings automatically; follow the support documentation’s manual recovery procedure." } }, "ja": { "stringUnit": { "state": "translated", "value": "手動復元が必要です。recovery files とバックアップを保持し、バックアップ内容を公開しないでください。アプリは Claude settings を自動で上書きしません。サポート文書の手動復元手順に従ってください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "수동 복구가 필요합니다. recovery files와 백업을 보관하고 백업 내용을 공개하지 마세요. 앱은 Claude settings를 자동으로 덮어쓰지 않습니다. 지원 문서의 수동 복구 절차를 따르세요." } }, "es": { "stringUnit": { "state": "translated", "value": "Se requiere recuperación manual. Conserva los recovery files y la copia de seguridad, y no compartas su contenido. La app no sobrescribirá automáticamente Claude settings; sigue el procedimiento de recuperación manual de la documentación de soporte." } }, "fr": { "stringUnit": { "state": "translated", "value": "Une récupération manuelle est requise. Conservez les recovery files et la sauvegarde, et ne partagez pas son contenu. L’app ne remplacera pas automatiquement Claude settings ; suivez la procédure de récupération manuelle de la documentation d’assistance." } }, "de": { "stringUnit": { "state": "translated", "value": "Eine manuelle Wiederherstellung ist erforderlich. Bewahren Sie die recovery files und die Sicherung auf und geben Sie deren Inhalt nicht weiter. Die App überschreibt Claude settings nicht automatisch; folgen Sie dem manuellen Wiederherstellungsverfahren in der Support-Dokumentation." } }
    } },
    "settings.claude_relay.state.invalid": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "設定格式無法安全處理；未進行修改" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "设置格式无法安全处理；未进行修改" } }, "en": { "stringUnit": { "state": "translated", "value": "Settings cannot be handled safely; nothing changed" } }, "ja": { "stringUnit": { "state": "translated", "value": "設定を安全に処理できないため変更していません" } }, "ko": { "stringUnit": { "state": "translated", "value": "설정을 안전하게 처리할 수 없어 변경하지 않음" } }, "es": { "stringUnit": { "state": "translated", "value": "Los ajustes no pueden procesarse con seguridad; no se cambió nada" } }, "fr": { "stringUnit": { "state": "translated", "value": "Les réglages ne peuvent pas être traités en sécurité ; aucune modification" } }, "de": { "stringUnit": { "state": "translated", "value": "Einstellungen können nicht sicher verarbeitet werden; nichts geändert" } }
    } },
    "settings.claude_relay.state.failed": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "讀取或操作失敗；未進行不確定的修改" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "读取或操作失败；未进行不确定的修改" } }, "en": { "stringUnit": { "state": "translated", "value": "Read or operation failed; no uncertain changes were made" } }, "ja": { "stringUnit": { "state": "translated", "value": "読み取りまたは操作に失敗しました。不確かな変更はしていません" } }, "ko": { "stringUnit": { "state": "translated", "value": "읽기 또는 작업 실패; 불확실한 변경은 하지 않음" } }, "es": { "stringUnit": { "state": "translated", "value": "Falló la lectura u operación; no se hicieron cambios inciertos" } }, "fr": { "stringUnit": { "state": "translated", "value": "Échec de lecture ou d’opération ; aucune modification incertaine" } }, "de": { "stringUnit": { "state": "translated", "value": "Lesen oder Vorgang fehlgeschlagen; keine unsicheren Änderungen" } }
    } },
