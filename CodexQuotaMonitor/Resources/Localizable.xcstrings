    "settings.group.providers": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "額度來源" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "额度来源" } }, "en": { "stringUnit": { "state": "translated", "value": "Quota Sources" } }, "ja": { "stringUnit": { "state": "translated", "value": "利用枠ソース" } }, "ko": { "stringUnit": { "state": "translated", "value": "할당량 소스" } }, "es": { "stringUnit": { "state": "translated", "value": "Fuentes de cuota" } }, "fr": { "stringUnit": { "state": "translated", "value": "Sources de quota" } }, "de": { "stringUnit": { "state": "translated", "value": "Kontingentquellen" } }
    } },
    "settings.providers.explanation": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "Codex 固定啟用；Claude Code 可自由勾選。勾選只會啟用本機顯示，不會修改 Claude Code 設定；額度連接需另行確認。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "Codex 固定启用；Claude Code 可自由勾选。勾选只会启用本机显示，不会修改 Claude Code 设置；额度连接需另行确认。" } }, "en": { "stringUnit": { "state": "translated", "value": "Codex stays enabled; Claude Code is optional. Selecting Claude only enables local display and does not change Claude Code settings; quota connection requires separate confirmation." } }, "ja": { "stringUnit": { "state": "translated", "value": "Codex は常に有効で、Claude Code は任意です。Claude を選択してもローカル表示が有効になるだけで設定は変更されません。利用枠の接続は別途確認が必要です。" } }, "ko": { "stringUnit": { "state": "translated", "value": "Codex는 항상 활성화되며 Claude Code는 선택 사항입니다. Claude 선택은 로컬 표시만 활성화하고 설정을 변경하지 않습니다. 할당량 연결은 별도 확인이 필요합니다." } }, "es": { "stringUnit": { "state": "translated", "value": "Codex permanece activo y Claude Code es opcional. Seleccionar Claude solo activa la visualización local y no cambia sus ajustes; la conexión de cuota requiere otra confirmación." } }, "fr": { "stringUnit": { "state": "translated", "value": "Codex reste activé et Claude Code est facultatif. Sélectionner Claude active seulement l’affichage local sans modifier ses réglages ; la connexion du quota demande une confirmation séparée." } }, "de": { "stringUnit": { "state": "translated", "value": "Codex bleibt aktiviert; Claude Code ist optional. Die Auswahl aktiviert nur die lokale Anzeige und ändert keine Claude-Code-Einstellungen. Die Kontingentverbindung muss separat bestätigt werden." } }
    } },
    "settings.providers.connection": { "extractionState": "manual", "localizations": {
      "zh-Hant": { "stringUnit": { "state": "translated", "value": "連線" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接" } }, "en": { "stringUnit": { "state": "translated", "value": "Connection" } }, "ja": { "stringUnit": { "state": "translated", "value": "接続" } }, "ko": { "stringUnit": { "state": "translated", "value": "연결" } }, "es": { "stringUnit": { "state": "translated", "value": "Conexión" } }, "fr": { "stringUnit": { "state": "translated", "value": "Connexion" } }, "de": { "stringUnit": { "state": "translated", "value": "Verbindung" } }
    } },
    "settings.providers.quota": { "extractionState": "manual", "localizations": {
