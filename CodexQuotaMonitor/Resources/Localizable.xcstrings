    "theme.editor.operation.duplicate_unavailable": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "目前主題不是可複製的內建主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前主题不是可复制的内置主题。" } }, "en": { "stringUnit": { "state": "translated", "value": "The current theme is not a built-in theme that can be duplicated." } }, "ja": { "stringUnit": { "state": "translated", "value": "現在のテーマは複製可能な内蔵テーマではありません。" } }, "ko": { "stringUnit": { "state": "translated", "value": "현재 테마는 복제할 수 있는 기본 제공 테마가 아닙니다." } }, "es": { "stringUnit": { "state": "translated", "value": "El tema actual no es un tema integrado que se pueda duplicar." } }, "fr": { "stringUnit": { "state": "translated", "value": "Le thème actuel n’est pas un thème intégré pouvant être dupliqué." } }, "de": { "stringUnit": { "state": "translated", "value": "Das aktuelle Theme ist kein duplizierbares integriertes Theme." } } } },
    "theme.editor.operation.duplicate_failed": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法複製主題。請稍後再試。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法复制主题。请稍后再试。" } }, "en": { "stringUnit": { "state": "translated", "value": "The theme could not be duplicated. Try again later." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマを複製できませんでした。後でもう一度お試しください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마를 복제할 수 없습니다. 나중에 다시 시도하세요." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo duplicar el tema. Inténtalo de nuevo más tarde." } }, "fr": { "stringUnit": { "state": "translated", "value": "Impossible de dupliquer le thème. Réessayez plus tard." } }, "de": { "stringUnit": { "state": "translated", "value": "Das Theme konnte nicht dupliziert werden. Später erneut versuchen." } } } },
    "theme.editor.operation.image_unsafe": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法使用這張圖片。請選擇安全的 PNG 或 JPEG。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法使用此图片。请选择安全的 PNG 或 JPEG。" } }, "en": { "stringUnit": { "state": "translated", "value": "This image cannot be used. Choose a safe PNG or JPEG." } }, "ja": { "stringUnit": { "state": "translated", "value": "この画像は使用できません。安全な PNG または JPEG を選択してください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "이 이미지는 사용할 수 없습니다. 안전한 PNG 또는 JPEG를 선택하세요." } }, "es": { "stringUnit": { "state": "translated", "value": "No se puede usar esta imagen. Elige un PNG o JPEG seguro." } }, "fr": { "stringUnit": { "state": "translated", "value": "Cette image ne peut pas être utilisée. Choisissez un PNG ou JPEG sûr." } }, "de": { "stringUnit": { "state": "translated", "value": "Dieses Bild kann nicht verwendet werden. Ein sicheres PNG oder JPEG auswählen." } } } },
    "theme.editor.operation.save_succeeded": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "已儲存主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "主题已保存。" } }, "en": { "stringUnit": { "state": "translated", "value": "Theme saved." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマを保存しました。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마를 저장했습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "Tema guardado." } }, "fr": { "stringUnit": { "state": "translated", "value": "Thème enregistré." } }, "de": { "stringUnit": { "state": "translated", "value": "Theme gesichert." } } } },
    "theme.editor.operation.save_applied": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "已儲存並套用主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "主题已保存并应用。" } }, "en": { "stringUnit": { "state": "translated", "value": "Theme saved and applied." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマを保存して適用しました。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마를 저장하고 적용했습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "Tema guardado y aplicado." } }, "fr": { "stringUnit": { "state": "translated", "value": "Thème enregistré et appliqué." } }, "de": { "stringUnit": { "state": "translated", "value": "Theme gesichert und angewendet." } } } },
    "theme.editor.operation.saved_not_applied": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "主題已儲存，但無法套用；目前仍使用先前主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "主题已保存，但无法应用；当前仍使用之前的主题。" } }, "en": { "stringUnit": { "state": "translated", "value": "The theme was saved but could not be applied; the previous theme remains in use." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマは保存されましたが適用できませんでした。以前のテーマが引き続き使用されます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마는 저장되었지만 적용할 수 없어 이전 테마를 계속 사용합니다." } }, "es": { "stringUnit": { "state": "translated", "value": "El tema se guardó, pero no se pudo aplicar; se sigue usando el tema anterior." } }, "fr": { "stringUnit": { "state": "translated", "value": "Le thème a été enregistré, mais n’a pas pu être appliqué ; le thème précédent reste utilisé." } }, "de": { "stringUnit": { "state": "translated", "value": "Das Theme wurde gesichert, konnte aber nicht angewendet werden; das vorherige Theme bleibt aktiv." } } } },
    "theme.editor.operation.save_failed": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法儲存主題；已保留目前草稿。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法保存主题；当前草稿已保留。" } }, "en": { "stringUnit": { "state": "translated", "value": "The theme could not be saved; the current draft was kept." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマを保存できませんでした。現在の下書きは保持されています。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마를 저장할 수 없어 현재 초안을 유지했습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo guardar el tema; se conservó el borrador actual." } }, "fr": { "stringUnit": { "state": "translated", "value": "Impossible d’enregistrer le thème ; le brouillon actuel a été conservé." } }, "de": { "stringUnit": { "state": "translated", "value": "Das Theme konnte nicht gesichert werden; der aktuelle Entwurf wurde beibehalten." } } } },
    "theme.editor.operation.reset_succeeded": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "已重設為內建主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "已重置为内置主题。" } }, "en": { "stringUnit": { "state": "translated", "value": "Reset to the built-in theme." } }, "ja": { "stringUnit": { "state": "translated", "value": "内蔵テーマにリセットしました。" } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 제공 테마로 재설정했습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "Se restableció el tema integrado." } }, "fr": { "stringUnit": { "state": "translated", "value": "Le thème intégré a été rétabli." } }, "de": { "stringUnit": { "state": "translated", "value": "Auf das integrierte Theme zurückgesetzt." } } } },
    "theme.editor.operation.reset_failed": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法重設主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法重置主题。" } }, "en": { "stringUnit": { "state": "translated", "value": "The theme could not be reset." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマをリセットできませんでした。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마를 재설정할 수 없습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo restablecer el tema." } }, "fr": { "stringUnit": { "state": "translated", "value": "Impossible de réinitialiser le thème." } }, "de": { "stringUnit": { "state": "translated", "value": "Das Theme konnte nicht zurückgesetzt werden." } } } },
    "theme.editor.operation.import_loaded": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "已載入匯入主題；儲存前仍可取消。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "已载入导入的主题；保存前仍可取消。" } }, "en": { "stringUnit": { "state": "translated", "value": "The imported theme is loaded; you can still cancel before saving." } }, "ja": { "stringUnit": { "state": "translated", "value": "読み込んだテーマをロードしました。保存前ならキャンセルできます。" } }, "ko": { "stringUnit": { "state": "translated", "value": "가져온 테마를 불러왔습니다. 저장하기 전에는 취소할 수 있습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "El tema importado está cargado; aún puedes cancelar antes de guardarlo." } }, "fr": { "stringUnit": { "state": "translated", "value": "Le thème importé est chargé ; vous pouvez encore annuler avant l’enregistrement." } }, "de": { "stringUnit": { "state": "translated", "value": "Das importierte Theme ist geladen; vor dem Sichern kann noch abgebrochen werden." } } } },
    "theme.editor.operation.import_failed": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法匯入主題。請確認檔案格式與安全性。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法导入主题。请确认文件格式和安全性。" } }, "en": { "stringUnit": { "state": "translated", "value": "The theme could not be imported. Check the file format and safety." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマを読み込めませんでした。ファイル形式と安全性を確認してください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마를 가져올 수 없습니다. 파일 형식과 안전성을 확인하세요." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo importar el tema. Comprueba el formato y la seguridad del archivo." } }, "fr": { "stringUnit": { "state": "translated", "value": "Impossible d’importer le thème. Vérifiez le format et la sécurité du fichier." } }, "de": { "stringUnit": { "state": "translated", "value": "Das Theme konnte nicht importiert werden. Dateiformat und Sicherheit prüfen." } } } },
    "theme.editor.operation.export_succeeded": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "已匯出主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "主题已导出。" } }, "en": { "stringUnit": { "state": "translated", "value": "Theme exported." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマを書き出しました。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마를 내보냈습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "Tema exportado." } }, "fr": { "stringUnit": { "state": "translated", "value": "Thème exporté." } }, "de": { "stringUnit": { "state": "translated", "value": "Theme exportiert." } } } },
    "theme.editor.operation.export_failed": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法匯出主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法导出主题。" } }, "en": { "stringUnit": { "state": "translated", "value": "The theme could not be exported." } }, "ja": { "stringUnit": { "state": "translated", "value": "テーマを書き出せませんでした。" } }, "ko": { "stringUnit": { "state": "translated", "value": "테마를 내보낼 수 없습니다." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo exportar el tema." } }, "fr": { "stringUnit": { "state": "translated", "value": "Impossible d’exporter le thème." } }, "de": { "stringUnit": { "state": "translated", "value": "Das Theme konnte nicht exportiert werden." } } } },
    "theme.editor.builtin_read_only": { "extractionState": "manual", "localizations": { "zh-Hant": { "stringUnit": { "state": "translated", "value": "內建主題不可修改。請先複製為自訂主題。" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "内置主题不可修改。请先复制为自定义主题。" } }, "en": { "stringUnit": { "state": "translated", "value": "Built-in themes cannot be modified. Duplicate one as a custom theme first." } }, "ja": { "stringUnit": { "state": "translated", "value": "内蔵テーマは変更できません。先にカスタムテーマとして複製してください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "기본 제공 테마는 수정할 수 없습니다. 먼저 사용자 지정 테마로 복제하세요." } }, "es": { "stringUnit": { "state": "translated", "value": "Los temas integrados no se pueden modificar. Duplica uno como tema personalizado primero." } }, "fr": { "stringUnit": { "state": "translated", "value": "Les thèmes intégrés ne peuvent pas être modifiés. Dupliquez-en d’abord un comme thème personnalisé." } }, "de": { "stringUnit": { "state": "translated", "value": "Integrierte Themes können nicht geändert werden. Zuerst als benutzerdefiniertes Theme duplizieren." } } } },
