    "onboarding.error.registration_failed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟用登入時自動啟動，請到「系統設定」檢查登入項目，或稍後在設定中重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启用登录时自动启动，请在“系统设置”中检查登录项，或稍后在设置中重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login could not be enabled. Check Login Items in System Settings or try again later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に開く設定を有効にできませんでした。システム設定のログイン項目を確認するか、後で設定画面からやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시 열기를 활성화할 수 없습니다. 시스템 설정에서 로그인 항목을 확인하거나 나중에 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo activar Abrir al iniciar sesión. Revisa los ítems de inicio o inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’activer l’ouverture à la connexion. Vérifiez les éléments d’ouverture ou réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bei Anmeldung öffnen“ konnte nicht aktiviert werden. Anmeldeobjekte prüfen oder später erneut versuchen."
          }
        }
      }
    },
    "onboarding.error.unregistration_failed": {
      "extractionState": "manual",
      "localizations": {
