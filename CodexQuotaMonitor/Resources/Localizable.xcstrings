    "settings.menu_bar.primary_provider": {"extractionState":"manual","localizations":{"zh-Hant":{"stringUnit":{"state":"translated","value":"主要平台"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"主要平台"}},"en":{"stringUnit":{"state":"translated","value":"Primary Provider"}},"ja":{"stringUnit":{"state":"translated","value":"優先プロバイダ"}},"ko":{"stringUnit":{"state":"translated","value":"기본 제공업체"}},"es":{"stringUnit":{"state":"translated","value":"Proveedor principal"}},"fr":{"stringUnit":{"state":"translated","value":"Fournisseur principal"}},"de":{"stringUnit":{"state":"translated","value":"Primärer Anbieter"}}}},
    "settings.menu_bar.all_providers_explanation": {"extractionState":"manual","localizations":{"zh-Hant":{"stringUnit":{"state":"translated","value":"儀表板與面板會顯示固定啟用的 Codex，以及你選用的 Claude Code 額度與狀態。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仪表板和面板会显示固定启用的 Codex，以及你选用的 Claude Code 额度与状态。"}},"en":{"stringUnit":{"state":"translated","value":"The dashboard and panel show the always-enabled Codex provider plus Claude Code quota and status when selected."}},"ja":{"stringUnit":{"state":"translated","value":"ダッシュボードとパネルには常に有効な Codex と、選択した場合は Claude Code の利用枠と状態が表示されます。"}},"ko":{"stringUnit":{"state":"translated","value":"대시보드와 패널에는 항상 활성화된 Codex와 선택한 경우 Claude Code 할당량 및 상태가 표시됩니다."}},"es":{"stringUnit":{"state":"translated","value":"El panel de control muestra Codex, siempre activo, y la cuota y el estado de Claude Code cuando se selecciona."}},"fr":{"stringUnit":{"state":"translated","value":"Le tableau de bord affiche Codex, toujours activé, ainsi que le quota et l’état de Claude Code lorsqu’il est sélectionné."}},"de":{"stringUnit":{"state":"translated","value":"Dashboard und Panel zeigen den stets aktivierten Codex-Anbieter sowie bei Auswahl Kontingent und Status von Claude Code."}}}},
    "settings.menu_bar.full_warning": {"extractionState":"manual","localizations":{"zh-Hant":{"stringUnit":{"state":"translated","value":"完整模式在 macOS 選單列擁擠時可能被系統隱藏。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完整模式在 macOS 菜单栏拥挤时可能被系统隐藏。"}},"en":{"stringUnit":{"state":"translated","value":"Full mode may be hidden by macOS when the menu bar is crowded."}},"ja":{"stringUnit":{"state":"translated","value":"フルモードは、macOS のメニューバーが混み合うとシステムによって隠されることがあります。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 모드는 macOS 메뉴 막대가 혼잡할 때 시스템에 의해 가려질 수 있습니다."}},"es":{"stringUnit":{"state":"translated","value":"macOS puede ocultar el modo completo cuando la barra de menús está llena."}},"fr":{"stringUnit":{"state":"translated","value":"macOS peut masquer le mode complet lorsque la barre des menus est encombrée."}},"de":{"stringUnit":{"state":"translated","value":"macOS kann den vollständigen Modus ausblenden, wenn die Menüleiste voll ist."}}}},
    "settings.menu_bar.position_help": {"extractionState":"manual","localizations":{"zh-Hant":{"stringUnit":{"state":"translated","value":"按住 Command 拖曳可調整位置。App 僅使用 macOS 公開的還原機制，因此位置只能盡力恢復，無法保證永遠固定在最左側。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按住 Command 拖动可调整位置。App 仅使用 macOS 公开的恢复机制，因此位置只能尽力恢复，无法保证始终固定在最左侧。"}},"en":{"stringUnit":{"state":"translated","value":"Hold Command while dragging to reposition. The app uses only macOS public restoration support, so placement is best effort and cannot be guaranteed at the far left."}},"ja":{"stringUnit":{"state":"translated","value":"Command キーを押しながらドラッグすると位置を変更できます。アプリは macOS の公開復元機能のみを使用するため、位置の復元はベストエフォートで、常に左端に固定されることは保証できません。"}},"ko":{"stringUnit":{"state":"translated","value":"Command 키를 누른 채 드래그하여 위치를 조정할 수 있습니다. 앱은 macOS의 공개 복원 기능만 사용하므로 위치 복원은 최선의 방식으로 이루어지며 항상 맨 왼쪽에 고정된다고 보장할 수 없습니다."}},"es":{"stringUnit":{"state":"translated","value":"Mantén pulsado Command mientras arrastras para cambiar la posición. La app solo usa la restauración pública de macOS, por lo que la posición se recupera en la medida de lo posible y no se garantiza que quede siempre a la izquierda."}},"fr":{"stringUnit":{"state":"translated","value":"Maintenez Command pendant le déplacement pour changer la position. L’app utilise uniquement la restauration publique de macOS ; le rétablissement est donc au mieux et la position tout à gauche ne peut pas être garantie."}},"de":{"stringUnit":{"state":"translated","value":"Halte beim Ziehen die Command-Taste gedrückt, um die Position zu ändern. Die App nutzt nur die öffentliche Wiederherstellung von macOS; die Position wird daher nach Möglichkeit wiederhergestellt und ganz links nicht garantiert."}}}},
    "settings.percentage.remaining": {"extractionState":"manual","localizations":{"zh-Hant":{"stringUnit":{"state":"translated","value":"剩餘"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"剩余"}},"en":{"stringUnit":{"state":"translated","value":"Remaining"}},"ja":{"stringUnit":{"state":"translated","value":"残り"}},"ko":{"stringUnit":{"state":"translated","value":"남음"}},"es":{"stringUnit":{"state":"translated","value":"Restante"}},"fr":{"stringUnit":{"state":"translated","value":"Restant"}},"de":{"stringUnit":{"state":"translated","value":"Verbleibend"}}}},
