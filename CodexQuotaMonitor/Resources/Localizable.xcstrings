          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login was skipped. You can enable it later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に開く設定をスキップしました。後で設定画面から有効にできます。"
