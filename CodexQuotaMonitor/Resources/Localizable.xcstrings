          "stringUnit": {
            "state": "translated",
            "value": "%@ muss zwischen %@ und %@ liegen. Vor dem Sichern anpassen."
          }
        }
      }
    },
    "theme.editor.error.invalid_contrast": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 與 %@ 對比不足。請提高明暗差異後再儲存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 与 %@ 对比不足。请提高明暗差异后再保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not have enough contrast against %@. Increase the difference before saving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ とのコントラストが不足しています。保存前に差を大きくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) %@에 대한 대비가 부족합니다. 저장하기 전에 차이를 높이세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene suficiente contraste con %@. Aumenta la diferencia antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas assez de contraste avec %@. Augmentez la différence avant d’enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht genügend Kontrast zu %@. Den Unterschied vor dem Sichern erhöhen."
          }
        }
      }
    },
    "theme.editor.error.invalid_color": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 外觀的 %@ 色彩格式無效。請輸入 #RRGGBB 或 #RRGGBBAA。"
