    "settings.theme.engine_pending": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題引擎完成後即可切換；目前不會假裝套用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题引擎完成后即可切换；当前不会假装应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme switching will be available when the theme engine is ready; no theme is being simulated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマエンジンの準備ができると切り替えられます。現在は適用を装いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 엔진이 준비되면 전환할 수 있으며 현재는 적용된 것처럼 표시하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio estará disponible cuando el motor de temas esté listo; ahora no se simula ningún tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement sera disponible lorsque le moteur de thèmes sera prêt ; aucun thème n’est simulé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wechsel ist verfügbar, sobald die Theme-Engine bereit ist; derzeit wird kein Theme simuliert."
          }
        }
      }
    },
